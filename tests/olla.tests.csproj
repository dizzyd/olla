<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Authoring only. The tests are compiled inside the game from the .cs files in
    this directory, so nothing here has to be built to run them:

        run.sh ../olla/tests  (with the mod flag pointing at ../olla/olla)

    This project exists so an editor can type-check them against the mod and the
    game. Building it is optional.
  -->
  <PropertyGroup>
    <AssemblyName>olla.tests</AssemblyName>
    <RootNamespace>Olla.Tests</RootNamespace>
    <TargetFramework>net10.0</TargetFramework>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin\$(Configuration)</OutputPath>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="VsTestkit.Runtime">
      <HintPath>$(VSTESTKIT)/VsTestkit.Runtime/bin/Debug/VsTestkit.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="olla">
      <HintPath>../olla/bin/Debug/Mods/mod/olla.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="VintagestoryAPI">
      <HintPath>$(VINTAGE_STORY)/VintagestoryAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="VSSurvivalMod">
      <HintPath>$(VINTAGE_STORY)/Mods/VSSurvivalMod.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>

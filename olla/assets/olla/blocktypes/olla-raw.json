{
  "code": "olla-raw",
  "class": "Block",
  behaviors: [
    { name: "GroundStorable", properties: { layout: 'SingleCenter' } },
    { name: "Unplaceable", }, // The ground storable obsoletes this being a block. Should be an item, but is kept a block for backwards compatibility
    { name: "RightClickPickup"}
  ],
  "variantgroups": [
    {
      "code": "color", "states": [ "blue", "fire", "red" ]
    }
  ],
  "creativeinventory": {
    "general": ["*"],
    "decorative": ["*"]
  },
  "shape": { "base": "olla:block/olla-raw" },
  "textures": {
    "all": { "base": "game:block/clay/{color}clay" }
  },
  "blockmaterial": "Ceramic",
  "drawtype": "JSON",
  "resistance": 0.8,
  "requiressolidground": true,
  "lightAbsorption": 0,
  "sidesolid": {
    "all": false
  },
  "sideopaque": {
    "all": false
  },
  "collisionbox": {
    "x1": 0.1875,
    "y1": 0,
    "z1": 0.1875,
    "x2": 0.8125,
    "y2": 1.125,
    "z2": 0.8125
  },
  "selectionbox": {
    "x1": 0.1875,
    "y1": 0,
    "z1": 0.1875,
    "x2": 0.8125,
    "y2": 1.125,
    "z2": 0.8125
  },
  "materialDensity": 200,
  "sounds": {
    "place": "game:block/dirt",
    "hit": "game:block/dirt",
    "break": "game:block/dirt",
    "walk": "game:walk/stone"
  },
  "combustibleProps": {
    "meltingPoint": 600,
    "meltingDuration": 45,
    "smeltedRatio": 1,
    "smeltingType": "fire",
    "smeltedStack": {
      "type": "block",
      "code": "olla:olla-fired-{color}-normal"
    },
    "requiresContainer": false
  },
  "drops": [
    {
      "type": "block",
      "code": "olla:olla-raw-{color}",
      "quantity": { "avg": 1 }
    }
  ],
  "maxstacksize": 8,
  "guiTransform": {
    "translation": { "x": 0, "y": 0.1, "z": 0 },
    "rotation": { "x": -22.5, "y": 45, "z": 0 },
    "origin": { "x": 0.5, "y": 0.5, "z": 0.5 },
    "scale": 1.6
  },
  "fpHandTransform": {
    "translation": { "x": 0, "y": 0.4, "z": 0 },
    "rotation": { "x": 0, "y": 0, "z": 0 },
    "origin": { "x": 0.5, "y": 0.2, "z": 0.5 },
    "scale": 2.2
  },
  "groundTransform": {
    "translation": { "x": 0, "y": 0, "z": 0 },
    "rotation": { "x": 0, "y": 0, "z": 0 },
    "origin": { "x": 0.5, "y": 0, "z": 0.5 },
    "scale": 3.0
  },
  "tpHandTransform": {
    "translation": { "x": -0.95, "y": -0.45, "z": -0.68 },
    "rotation": { "x": 0, "y": 0, "z": 0 },
    "origin": { "x": 0.5, "y": 0.2, "z": 0.5 },
    "scale": 0.65
  },
  // A beehive kiln fires by atmosphere, keyed by how many of its three back doors stand
  // open, and reads this map ahead of combustibleProps. The pit kiln and other kilns still
  // read smeltedStack and give the plain clay colour. The maps are vanilla's own for its
  // cooking pot (blocktypes/clay/raw/pot.json).
  "attributesByType": {
    "olla-raw-red": {
      "handbook": { "groupBy": ["olla-raw-*"] },
      "beehivekiln": {
        "0": { "type": "block", "code": "olla:olla-fired-tan-normal" },
        "1": { "type": "block", "code": "olla:olla-fired-orange-normal" },
        "2": { "type": "block", "code": "olla:olla-fired-red-normal" },
        "3": { "type": "block", "code": "olla:olla-fired-brown-normal" }
      }
    },
    "olla-raw-blue": {
      "handbook": { "groupBy": ["olla-raw-*"] },
      "beehivekiln": {
        "0": { "type": "block", "code": "olla:olla-fired-cream-normal" },
        "1": { "type": "block", "code": "olla:olla-fired-gray-normal" },
        "2": { "type": "block", "code": "olla:olla-fired-black-normal" },
        "3": { "type": "block", "code": "olla:olla-fired-black-normal" }
      }
    },
    "olla-raw-fire": {
      "handbook": { "groupBy": ["olla-raw-*"] },
      "beehivekiln": {
        "0": { "type": "block", "code": "olla:olla-fired-fire-normal" },
        "1": { "type": "block", "code": "olla:olla-fired-fire-normal" },
        "2": { "type": "block", "code": "olla:olla-fired-fire-normal" },
        "3": { "type": "block", "code": "olla:olla-fired-fire-normal" }
      }
    }
  }
}
